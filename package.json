{
  "name": "aixmeme",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:all": "bun --filter '*' dev",
    "dev:server": "bun --filter @mimedime/server dev",
    "dev:ui": "bun --filter @memedime/ui dev",
    "cp:emojis": "cp  -r ./apps/server/static/emojis.json ./apps/ui/src/emojis.json"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "drizzle-kit": "^0.31.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
