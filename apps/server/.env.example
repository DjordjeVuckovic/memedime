PORT=1312
TZ=UTC

# Database - Local dev uses SQLite file, production uses Turso
# Local: file:./memedime.db
# Production: libsql://your-database.turso.io
DB_URL=file:./memedime.db
# Only needed for remote Turso database (get from: turso db tokens create <db-name>)
DB_AUTH_TOKEN=

# LLM Configuration
LLM_PROVIDER=groq
# populate value if you are using ollama: http://localhost:11434/api/ or proxy
LLM_BASE_URL=
LLM_MODEL_ID=llama-3.1-8b-instant
LLM_API_KEY=<your-api-key>

# CORS - comma separated origins for production
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
